        },
        {
            "title": "Employee update request",
            "properties": {
                "objectType": {
                    "const": "employee"
                },
                "operation": {
                    "const": "update"
                },
                "subject": {
                    "const": "erp.employee.update"
                },
                "payload": {
                    "$ref": "../../model/employee/employee.schema.json"
                }
            }
        },
        {
            "title": "Employee delete request",
            "properties": {
                "objectType": {
                    "const": "employee"
                },
                "operation": {
                    "const": "delete"
                },
                "subject": {
                    "const": "erp.employee.delete"
                },
                "payload": {
                    "$ref": "#/$defs/deletePayload"
                }
            }
        },
        {
            "title": "Responsibility center create request",
            "properties": {
                "objectType": {
                    "const": "responsibilityCenter"
                },
                "operation": {
                    "const": "create"
                },
                "subject": {
                    "const": "erp.responsibilityCenter.create"
                },
                "payload": {
                    "$ref": "../../model/responsibilityCenter/responsibilitycenter.schema.json"
                }
            }
        },
        {
            "title": "Responsibility center update request",
            "properties": {
                "objectType": {
                    "const": "responsibilityCenter"
                },
                "operation": {
                    "const": "update"
                },
                "subject": {
                    "const": "erp.responsibilityCenter.update"
                },
                "payload": {
                    "$ref": "../../model/responsibilityCenter/responsibilitycenter.schema.json"
                }
            }
        },
        {
            "title": "Responsibility center delete request",
            "properties": {
                "objectType": {
                    "const": "responsibilityCenter"
                },
