                },
                "subject": {
                    "const": "erp.customerPriceGroup.update"
                },
                "payload": {
                    "$ref": "../../model/customerPriceGroup/customerPriceGroup.schema.json"
                }
            }
        },
        {
            "title": "Customer price group delete request",
            "properties": {
                "objectType": {
                    "const": "customerPriceGroup"
                },
                "operation": {
                    "const": "delete"
                },
                "subject": {
                    "const": "erp.customerPriceGroup.delete"
                },
                "payload": {
                    "$ref": "#/$defs/deletePayload"
                }
            }
        },
        {
            "title": "Employee create request",
            "properties": {
                "objectType": {
                    "const": "employee"
                },
                "operation": {
