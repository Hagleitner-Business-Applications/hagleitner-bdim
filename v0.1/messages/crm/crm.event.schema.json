{
  "$id": "https://schema.hagleitner.com/bdim/v0.1/crm.event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-revision": "2026-06-22",
  "x-status": "draft",
  "title": "CRM Event",
  "description": "Generic schema for events published by CRM. Properties marked with x-layer='transport' are mapped to AMQP message properties and are documented here for discoverability and contract documentation purposes.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "message-id",
    "messageVersion",
    "sourceSystem",
    "objectType",
    "operation",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "message-id": {
      "type": "string",
      "description": "AMQP message-id.",
      "x-layer": "transport"
    },
    "messageVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Message contract version.",
      "x-layer": "business",
      "x-status": "draft"
    },
    "sourceSystem": {
      "type": "string",
      "description": "Source system that generated the event.",
      "const": "CRM",
      "x-layer": "business"
    },
    "objectType": {
      "type": "string",
      "description": "Type of business object affected by the event.",
      "enum": [
        "customer",
        "customerPriceGroup",
        "employee",
        "responsibilityCenter"
      ],
      "x-layer": "business"
    },
    "operation": {
      "type": "string",
      "description": "Business operation that occurred in CRM.",
      "enum": [
        "created",
        "updated",
        "deleted"
      ],
      "x-layer": "business"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the business event occurred in the source system.",
      "x-layer": "business"
    },
    "payload": {
      "description": "Event payload. The concrete schema is selected by objectType and operation.",
      "x-layer": "business"
    }
  },
  "oneOf": [
    {
      "title": "Customer created",
      "x-designDecision": "ERP-owned attributes are intentionally excluded from customer created events since they are managed by the ERP system and are not known to the CRM system on creation.",
      "properties": {
        "objectType": { "const": "customer" },
        "operation": { "const": "created" },
        "payload": {
          "allOf": [
            { "$ref": "../../model/customer/customer.crm.schema.json" },
            { "$ref": "../../model/customer/customer.common.schema.json" }
          ]
        }
      }
    },
    {
      "title": "Customer updated",
      "properties": {
        "objectType": { "const": "customer" },
        "operation": { "const": "updated" },
        "payload": { "$ref": "../../model/customer/customer.schema.json" }
      }
    },
    {
      "title": "Customer deleted",
      "properties": {
        "objectType": { "const": "customer" },
        "operation": { "const": "deleted" },
        "payload": { "$ref": "#/$defs/deletePayload" }
      }
    },
    {
      "title": "Customer price group created or updated",
      "properties": {
        "objectType": { "const": "customerPriceGroup" },
        "operation": { "enum": ["created", "updated"] },
        "payload": { "$ref": "../../model/customerPriceGroup/customerPriceGroup.schema.json" }
      }
    },
    {
      "title": "Customer price group deleted",
      "properties": {
        "objectType": { "const": "customerPriceGroup" },
        "operation": { "const": "deleted" },
        "payload": { "$ref": "#/$defs/deletePayload" }
      }
    },
    {
      "title": "Employee created or updated",
      "properties": {
        "objectType": { "const": "employee" },
        "operation": { "enum": ["created", "updated"] },
        "payload": { "$ref": "../../model/employee/employee.schema.json" }
      }
    },
    {
      "title": "Employee deleted",
      "properties": {
        "objectType": { "const": "employee" },
        "operation": { "const": "deleted" },
        "payload": { "$ref": "#/$defs/deletePayload" }
      }
    },
    {
      "title": "Responsibility center created or updated",
      "properties": {
        "objectType": { "const": "responsibilityCenter" },
        "operation": { "enum": ["created", "updated"] },
        "payload": { "$ref": "../../model/responsibilityCenter/responsibilitycenter.schema.json" }
      }
    },
    {
      "title": "Responsibility center deleted",
      "properties": {
        "objectType": { "const": "responsibilityCenter" },
        "operation": { "const": "deleted" },
        "payload": { "$ref": "#/$defs/deletePayload" }
      }
    }
  ],
  "$defs": {
    "deletePayload": {
      "type": "object",
      "description": "Minimal payload for delete events.",
      "unevaluatedProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "../../model/components/baseTypes.schema.json#/$defs/uuid",
          "description": "UUID of the deleted business object."
        }
      }
    }
  }
}
