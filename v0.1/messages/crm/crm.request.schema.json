{
    "$id": "https://schema.hagleitner.com/bdim/v0.1/crm.request.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-revision": "2026-06-23",
    "x-status": "draft",
    "title": "CRM Request",
    "description": "Generic schema for business requests sent by CRM.",
    "type": "object",
    "unevaluatedProperties": false,
    "required": [
        "message-id",
        "messageVersion",
        "correlation-id",
        "reply-to",
        "content-type",
        "sourceSystem",
        "objectType",
        "operation",
        "requestedAt",
        "payload"
    ],
    "properties": {
        "message-id": {
            "type": "string",
            "format": "uuid",
            "description": "AMQP message-id. In Azure Service Bus this should be set on the transport message, for example ServiceBusMessage.MessageId.",
            "x-layer": "transport"
        },
        "messageVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$",
            "description": "Message contract version.",
            "x-layer": "business",
            "x-status": "draft"
        },
        "correlation-id": {
            "type": "string",
            "format": "uuid",
            "description": "AMQP correlation-id used to correlate request and response messages.",
            "x-layer": "transport"
        },
        "reply-to": {
            "type": "string",
            "minLength": 1,
            "description": "AMQP reply-to property. For request/response flows this identifies the queue or topic where the response should be sent.",
            "x-layer": "transport"
        },
        "content-type": {
            "type": "string",
            "const": "application/json",
            "description": "AMQP content-type property.",
            "x-layer": "transport"
        },
        "to": {
            "type": "string",
            "minLength": 1,
            "description": "Optional logical representation of the AMQP to property. This may contain the target queue, topic or logical receiver address.",
            "x-layer": "transport"
        },
        "sourceSystem": {
            "type": "string",
            "description": "Logical source system that created the request.",
            "enum": [
                "CRM"
            ]
        },
        "objectType": {
            "type": "string",
            "description": "Type of business object affected by the request.",
            "enum": [
                "customer",
                "customerPriceGroup",
                "employee",
                "responsibilityCenter"
            ]
        },
        "operation": {
            "type": "string",
            "description": "Business operation requested by CRM.",
            "enum": [
                "create",
                "update",
                "delete"
            ]
        },
        "requestedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the business request was created in the source system. This is business metadata and intentionally part of the JSON body."
        },
        "payload": {
            "description": "Request payload. The concrete schema is selected by objectType and operation."
        }
    },
    "oneOf": [
        {
            "title": "Customer create or update request",
            "properties": {
                "objectType": {
                    "const": "customer"
                },
                "operation": {
                    "enum" : ["create", "update"]
                },
                "payload": {
                    "allOf":  [
                        {
                        "$ref": "../../model/customer/customer.common.schema.json"
                        },
                        {
                        "$ref": "../../model/customer/customer.crm.schema.json"
                        }
                    ]
                    
                }
            }
        },
        {
            "title": "Customer delete request",
            "properties": {
                "objectType": {
                    "const": "customer"
                },
                "operation": {
                    "const": "delete"
                },
                "payload": {
                    "$ref": "#/$defs/deletePayload"
                }
            }
        },
        {
            "title": "Customer price group create or update request",
            "properties": {
                "objectType": {
                    "const": "customerPriceGroup"
                },
                "operation": {
                          "enum" : ["create", "update"]
                },
                "payload": {
                    "$ref": "../../model/customerPriceGroup/customerPriceGroup.schema.json"
                }
            }
        },
        {
            "title": "Customer price group delete request",
            "properties": {
                "objectType": {
                    "const": "customerPriceGroup"
                },
                "operation": {
                    "const": "delete"
                },
                "payload": {
                    "$ref": "#/$defs/deletePayload"
                }
            }
        },
        {
            "title": "Employee create or update request",
            "properties": {
                "objectType": {
                    "const": "employee"
                },
                "operation": {
                           "enum" : ["create", "update"]
                },
                "payload": {
                    "$ref": "../../model/employee/employee.schema.json"
                }
            }
        },
        {
            "title": "Employee delete request",
            "properties": {
                "objectType": {
                    "const": "employee"
                },
                "operation": {
                    "const": "delete"
                },
                "payload": {
                    "$ref": "#/$defs/deletePayload"
                }
            }
        },
        {
            "title": "Responsibility center create or update request",
            "properties": {
                "objectType": {
                    "const": "responsibilityCenter"
                },
                "operation": {
                    "enum": ["create", "update"]
                },
                "payload": {
                    "$ref": "../../model/responsibilityCenter/responsibilitycenter.schema.json"
                }
            }
        },
        {
            "title": "Responsibility center delete request",
            "properties": {
                "objectType": {
                    "const": "responsibilityCenter"
                },
                "operation": {
                    "const": "delete"
                },
                "payload": {
                    "$ref": "#/$defs/deletePayload"
                }
            }
        }
    ],
    "$defs": {
        "deletePayload": {
            "type": "object",
            "description": "Minimal payload for delete requests.",
            "unevaluatedProperties": false,
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "$ref": "../../model/components/basetypes.schema.json#/$defs/uuid",
                    "description": "UUID of the business object to delete."
                }
            }
        }
    }
}
