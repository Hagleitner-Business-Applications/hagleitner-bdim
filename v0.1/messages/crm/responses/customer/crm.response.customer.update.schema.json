{
  "$id": "https://schema.hagleitner.com/bdim/v0.1/crm.response.customer.update.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-revision": "2026-06-22",
  "x-status": "draft",
  "title": "Response customer update",
  "description": "Schema for customer update responses sent back from ERP.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "messageVersion",
    "sourceSystem",
    "objectType",
    "operation"
  ],
  "properties": {
        "messageVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "Message contract version.",
          "x-layer": "business",
          "x-status": "draft"
        },
        "sourceSystem": {
          "type": "string",
          "description": "Source system that generated the event.",
          "const": "ERP"
        },
        "objectType": {
          "type": "string",
          "description": "Type of business object affected by the event.",
          "const": "customer"
        },
        "operation": {
          "type": "string",
          "description": "Business operation that occurred in ERP.",
          "const": "update"
        },
        "success": {
          "type": "boolean",
          "description": "Indicates whether the request was processed successfully."
        },
        "payload": {
          "description": "Business payload returned on success."
        },
        "exception": {

        }  
    },
    "oneOf": [
    {
      "title": "Customer update success response",
      "properties": {
        "success": {
          "const": true
        },
        "objectType": {
          "const": "customer"
        },
        "payload": {
          "anyOf": [
            {    
              "$ref": "#/$defs/idPayload"
            }
          ]
        }
      },
      "required": [
        "payload"
      ],
      "not": {
        "required": [
          "exception"
        ]
      }
    },
    {
      "title": "Error response",
      "properties": {
        "success": {
          "const": false
        },
        "exception": {
          "$ref": "../../../common/exception.schema.json"
        }
      },
      "required": [
        "exception"
      ],
      "not": {
        "required": [
          "payload"
        ]
      }
    }
  ],
    "$defs": {
    "idPayload": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "../../../../model/components/basetypes.schema.json#/$defs/uuid"
        }
      }
    }
  }
}
