{
  "$id": "crm.response.employee.delete.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-revision": "2026-06-22",
  "x-status": "draft",
  "title": "Response employee delete",
  "description": "Schema for employee delete responses sent back from ERP.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "messageVersion",
    "sourceSystem",
    "objectType",
    "operation"
  ],
  "properties": {
        "messageVersion": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+$",
        "description": "Message contract version.",
        "x-layer": "business",
        "x-status": "draft"
        },
        "sourceSystem": {
        "type": "string",
        "description": "Source system that generated the event.",
        "const": "CRM"
        },
        "objectType": {
        "type": "string",
        "description": "Type of business object affected by the event.",
        "const": "employee"
        },
        "operation": {
        "type": "string",
        "description": "Business operation that occurred in CRM.",
        "const": "delete"
        },
        "success": {
          "type": "boolean",
          "description": "Indicates whether the request was processed successfully."
        },
        "payload": {
          "description": "Business payload returned on success."
        },
        "exception": {
          "description": "Exception thrown on error.",
          "$ref": "../../common/exception.schema.json"
        }  
    },
    "$defs": {
        "deletePayload": {
            "type": "object",
            "description": "Minimal payload for delete requests.",
            "unevaluatedProperties": false,
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "$ref": "../../../../model/components/basetypes.schema.json#/$defs/uuid",
                    "description": "UUID of the business object to delete."
                }
            }
        }
    }
}
