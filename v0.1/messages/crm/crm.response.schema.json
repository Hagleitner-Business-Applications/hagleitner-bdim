{
  "$id": "https://schema.hagleitner.com/bdim/v0.1/crm.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-revision": "2026-06-23",
  "x-status": "draft",
  "title": "CRM Response",
  "description": "Generic schema for responses sent from backend systems to CRM.",
  "type": "object",
  "unevaluatedProperties": false,

  "required": [
    "message-id",
    "messageVersion",
    "correlation-id",
    "sourceSystem",
    "targetSystem",
    "objectType",
    "success"
  ],

  "properties": {
    "message-id": {
      "type": "string",
      "description": "AMQP message-id",
      "x-layer": "transport",
      "x-amqp-property": "message-id"
    },

    "messageVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Message contract version."
    },

    "correlation-id": {
      "type": "string",
      "description": "AMQP correlation-id",
      "x-layer": "transport",
      "x-amqp-property": "correlation-id"
    },

    "sourceSystem": {
      "type": "string",
      "description": "System generating the response.",
      "const": "CRM"
    },

    "targetSystem": {
      "type": "string",
      "description": "Target system of the response.",
      "const": "CRM"
    },

    "objectType": {
      "type": "string",
      "enum": [
        "customer",
        "customerPriceGroup",
        "employee",
        "responsibilityCenter"
      ]
    },

    "success": {
      "type": "boolean",
      "description": "Indicates whether the request was processed successfully."
    },

    "payload": {
      "description": "Business payload returned on success."
    },

    "exception": {
      "$ref": "../common/exception.schema.json"
    }
  },
  "oneOf": [
    {
      "title": "Customer success response",
      "properties": {
        "success": {
          "const": true
        },
        "objectType": {
          "const": "customer"
        },
        "payload": {
          "$ref": "../../model/customer/customer.erp.schema.json"
        }
      },
      "required": [
        "payload"
      ]
    },

    {
      "title": "Customer price group success response",
      "properties": {
        "success": {
          "const": true
        },
        "objectType": {
          "const": "customerPriceGroup"
        },
        "payload": {
          "$ref": "#/$defs/idPayload"
        }
      },
      "required": [
        "payload"
      ]
    },

    {
      "title": "Employee success response",
      "properties": {
        "success": {
          "const": true
        },
        "objectType": {
          "const": "employee"
        },
        "payload": {
          "$ref": "#/$defs/idPayload"
        }
      },
      "required": [
        "payload"
      ]
    },

    {
      "title": "Responsibility center success response",
      "properties": {
        "success": {
          "const": true
        },
        "objectType": {
          "const": "responsibilityCenter"
        },
        "payload": {
          "$ref": "#/$defs/idPayload"
        }
      },
      "required": [
        "payload"
      ]
    },

    {
      "title": "Error response",
      "properties": {
        "success": {
          "const": false
        }
      },
      "required": [
        "exception"
      ],
      "not": {
        "required": [
          "payload"
        ]
      }
    }
  ],

  "$defs": {
    "idPayload": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "../../components/baseTypes.schema.json#/$defs/uuid"
        }
      }
    }
  }
}