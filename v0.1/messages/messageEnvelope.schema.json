{
  "$id": "https://schema.hagleitner.com/bdim/v0.1/messageEnvelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "BDMI Message Envelope",
  "description": "Common envelope used by all BDMI messages.",

  "type": "object",

  "required": [
    "messageId",
    "messageType",
    "messageVersion",
    "sourceSystem",
    "occurredAt",
    "payload"
  ],

  "properties": {

    "messageId": {
      "$ref": "../components/baseTypes.schema.json#/$defs/uuid",
      "description": "Unique identifier of this message.",
      "x-status": "draft"
    },

    "messageType": {
      "type": "string",
      "minLength": 1,
      "description": "Type of message, e.g. CreateCustomerInERP.",
      "x-status": "draft"
    },

    "messageVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Message contract version.",
      "x-status": "draft"
    },

    "sourceSystem": {
      "type": "string",
      "minLength": 1,
      "description": "System that created the message, e.g. CRM, BC, PIM.",
      "x-status": "draft"
    },

    "targetSystem": {
      "type": "string",
      "minLength": 1,
      "description": "Optional target system. Usually used for requests.",
      "x-status": "draft"
    },

    "correlationId": {
      "$ref": "../components/baseTypes.schema.json#/$defs/uuid",
      "description": "Identifier used to correlate requests and responses.",
      "x-status": "draft"
    },

    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the event or command was created.",
      "x-status": "draft"
    },

    "replyTo": {
      "type": "object",
      "description": "Response routing information for request/response scenarios.",
      "required": [
        "queue"
      ],
      "properties": {
        "queue": {
          "type": "string",
          "minLength": 1,
          "description": "Application-owned queue used for responses."
        }
      },
      "additionalProperties": false,
      "x-status": "draft"
    },

    "payload": {
      "type": "object",
      "description": "Business payload of the message.",
      "x-status": "draft"
    }
  },

  "additionalProperties": false
}