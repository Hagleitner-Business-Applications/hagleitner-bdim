{
  "$id": "https://schema.hagleitner.com/bdim/v0.1/erp.response.customer.delete.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-revision": "2026-06-22",
  "x-status": "draft",
  "title": "Response customer delete",
  "description": "Schema for customer delete responses sent back from CRM.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "messageVersion",
    "sourceSystem",
    "objectType",
    "operation"
  ],
  "properties": {
        "messageVersion": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+$",
        "description": "Message contract version.",
        "x-layer": "business",
        "x-status": "draft"
        },
        "sourceSystem": {
        "type": "string",
        "description": "Source system that generated the event.",
        "const": "CRM"
        },
        "objectType": {
        "type": "string",
        "description": "Type of business object affected by the event.",
        "const": "customer"
        },
        "operation": {
        "type": "string",
        "description": "Business operation that occurred in ERP.",
        "const": "delete"
        },
        "success": {
          "type": "boolean",
          "description": "Indicates whether the request was processed successfully."
        },
        "payload": {
          "description": "Business payload returned on success."
        },
        "exception": {
           "description": "Exception thrown on error."
        }  
    },"oneOf": [
    {
      "title": "Customer delete success response",
      "properties": {
        "success": {
          "const": true
        },
        "objectType": {
          "const": "customer"
        },
        "payload": {
          "description": "Request payload. Contains the UUID of the deleted business object.",
          "unevaluatedProperties": false,
          "allOf": [
            {    
              "$ref": "#/$defs/deletePayload"
            },
            {    
              "$ref": "../../../../model/customer/customer.crm.schema.json"
            }
          ]
        }
      },
      "required": [
        "payload"
      ],
      "not": {
        "required": [
          "exception"
        ]
      }
    },
    {
      "title": "Error response",
      "properties": {
        "success": {
          "const": false
        }, 
        "exception": {
          "description": "Exception thrown on error.",
          "unevaluatedProperties": false,
          "allOf": [
            {    
              "$ref": "../../../common/exception.schema.json"
            }
          ]     
        }
      },
      "required": [
        "exception"
      ],
      "not": {
        "required": [
          "payload"
        ]
      }
    }
  ],
    "$defs": {
        "deletePayload": {
            "type": "object",
            "description": "Minimal payload for delete requests.",
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "$ref": "../../../../model/components/basetypes.schema.json#/$defs/uuid",
                    "description": "UUID of the business object to delete."
                }
            }
        }
    }
}
