{
  "$id": "https://schema.hagleitner.com/bdim/v0.1/erp.request.customer.update.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-revision": "2026-06-22",
  "x-status": "draft",
  "title": "ERP Request customer update",
  "description": "Schema for customer update requests in ERP.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "messageVersion",
    "sourceSystem",
    "objectType",
    "operation",
    "occurredAt",
    "payload"
  ],
  "properties": {
        "messageVersion": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+$",
        "description": "Message contract version.",
        "x-layer": "business",
        "x-status": "draft"
        },
        "sourceSystem": {
        "type": "string",
        "description": "Source system that generated the event.",
        "const": "ERP"
        },
        "objectType": {
        "type": "string",
        "description": "Type of business object affected by the event.",
        "const": "customer"
        },
        "operation": {
        "type": "string",
        "description": "Business operation that occurred in CRM.",
        "const": "update"
        },
        "occurredAt": {
        "type": "string",
        "format": "date-time",
        "description": "Timestamp when the business event occurred in the source system."
        },
        "payload": {
            "description": "Request payload. Contains the data for the customer to be updated.",
            "allOf": [
              { "$ref": "../../../../model/customer/customer.common.schema.json" },
              { "$ref": "../../../../model/customer/customer.erp.schema.json" }
            ],
            "unevaluatedProperties": false
        }
    }
}
