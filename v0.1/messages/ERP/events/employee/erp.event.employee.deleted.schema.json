{
  "$id": "erp.event.employee.deleted.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-revision": "2026-06-22",
  "x-status": "draft",
  "title": "ERP Event employee deleted",
  "description": "Schema for employee deleted events in ERP.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "messageVersion",
    "sourceSystem",
    "objectType",
    "operation",
    "occurredAt",
    "payload"
  ],
  "properties": {
        "messageVersion": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+$",
        "description": "Message contract version.",
        "x-layer": "business",
        "x-status": "draft"
        },
        "sourceSystem": {
        "type": "string",
        "description": "Source system that generated the event.",
        "const": "ERP"
        },
        "objectType": {
        "type": "string",
        "description": "Type of business object affected by the event.",
        "const": "employee"
        },
        "operation": {
        "type": "string",
        "description": "Business operation that occurred in ERP.",
        "const": "deleted"
        },
        "occurredAt": {
        "type": "string",
        "format": "date-time",
        "description": "Timestamp when the business event occurred in the source system."
        },
        "payload": {
            "$ref": "#/$defs/deletePayload"
        }
    },
    "$defs": {
        "deletePayload": {
            "type": "object",
            "description": "Minimal payload for delete requests.",
            "unevaluatedProperties": false,
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "$ref": "../../../../model/components/basetypes.schema.json#/$defs/uuid",
                    "description": "UUID of the business object to delete."
                }
            }
        }
    }
}
