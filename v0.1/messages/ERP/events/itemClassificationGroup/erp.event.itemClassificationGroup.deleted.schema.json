      "x-layer": "business",
      "x-status": "draft"
    },
    "sourceSystem": { "type": "string", "const": "ERP" },
    "objectType": { "type": "string", "const": "itemClassificationGroup" },
    "operation": { "type": "string", "const": "deleted" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "description": "Code of the deleted item classification group.",
      "unevaluatedProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "$ref": "../../../../model/components/basetypes.schema.json#/$defs/code",
          "maxLength": 10
        }
      }
    }
  }
}
