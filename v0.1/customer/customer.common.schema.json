{
    "$id": "https://schema.hagleitner.com/bdim/v0.1/customer.common.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-revision": "2026-05-11",
    "description": "This it the schema for common customer properties that are shared accoss different sytems. Entities of this schema can be owned by different source systems.",
    "type": "object",
    "required": [
        "id",
        "name1",
        "customerRelations",
        "languageTag",
        "createdAt",
        "contentHash"
    ],
    "properties": {
        "id": {
            "$ref": "../components/baseTypes.schema.json#/$defs/uuid",
            "description": "UUID uniquely identifying the customer.",
            "x-status": "approved"
        },
        "erpTenantId": {
            "$ref": "../components/baseTypes.schema.json#/$defs/uuid",
            "description": "UUID of the ERP tenant associated with this customer. This Id must be set by the owning system.",
            "x-status": "approved"
        },
        "name1": {
            "$ref": "../components/baseTypes.schema.json#/$defs/singleLineText",
            "maxLength": 100,
            "description": "Primary customer name line.",
            "x-status": "approved"
        },
        "name2": {
            "$ref": "../components/baseTypes.schema.json#/$defs/singleLineTextOrNull",
            "maxLength": 50,
            "description": "Secondary customer name line.",
            "x-status": "approved"
        },
        "name3": {
            "$ref": "../components/baseTypes.schema.json#/$defs/singleLineTextOrNull",
            "maxLength": 30,
            "description": "Tertiary customer name line.",
            "x-status": "approved"
        },
        "phoneNumber1": {
            "$ref": "../components/baseTypes.schema.json#/$defs/phoneE164OrNull",
            "description": "Phone number 1",
            "x-status": "approved"
        },
        "phoneNumber2": {
            "$ref": "../components/baseTypes.schema.json#/$defs/phoneE164OrNull",
            "description": "Phone number 2",
            "x-status": "approved"
        },
        "emailAddress": {
            "$ref": "../components/baseTypes.schema.json#/$defs/emailOrNull",
            "description": "Email address of the customer.",
            "x-status": "approved"
        },
        "responsibilityCenterId": {
            "$ref": "../components/baseTypes.schema.json#/$defs/uuidOrNull",
            "description": "UUID referencing the responsibility center that this customer is assigned to.",
            "x-status": "approved"
        },
        "blockedFor": {
            "type": "string",
            "enum": [
                "none",
                "shipping",
                "invoicing",
                "all"
            ],
            "default": "none",
            "description": "Defines what cannot be done for the customer.",
            "x-status": "approved"
        },
        "blockedForReason": {
            "type": "string",
            "description": "Descriptive reason for the block on the customer.",
            "maxLength": 60,
            "x-status": "approved"
        },
        "languageTag": {
            "$ref": "../components/baseTypes.schema.json#/$defs/languageTag",
            "description": "A BCP 47 language tag that identifies the language context, often including region or script. The languag tag is used as the key for resolving a locale or culture with concrete formatting conventions.",
            "x-status": "approved"
        },
        "timezone": {
            "type": "string",
            "pattern": "^[A-Za-z]+/[A-Za-z_]+(?:/[A-Za-z_]+)?$",
            "description": "The IANA time zone identifier representing the customer's time zone, such as 'America/New_York' or 'Europe/Berlin'.",
            "default": "Etc/UTC",
            "x-status": "approved"
        },
        "taxNumbers": {
            "type": "object",
            "properties": {
                "vatNumber": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/singleLineTextOrNull",
                    "maxLength": 20,
                    "x-status": "approved"
                },
                "eoriNumber": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/singleLineTextOrNull",
                    "maxLength": 40,
                    "x-status": "approved"
                },
                "taxNumber1": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/singleLineTextOrNull",
                    "maxLength": 50,
                    "x-status": "approved"
                },
                "taxNumber2": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/singleLineTextOrNull",
                    "maxLength": 80,
                    "x-status": "approved"
                },
                "taxNumber3": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/singleLineTextOrNull",
                    "maxLength": 30,
                    "x-status": "approved"
                },
                "taxNumber4": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/singleLineTextOrNull",
                    "maxLength": 30,
                    "x-status": "approved"
                }
            },
            "x-status": "approved"
        },
        "roles": {
            "type": "array",
            "items": {
                "type": "string",
                "enum": [
                    "reseller"
                ]
            },
            "uniqueItems": true,
            "description": "Roles assigned to the customer",
            "minItems": 1,
            "x-status": "approved"
        },
        "customerRelations": {
            "type": "object",
            "description": "Defines the customer's relationships to other customers.",
            "unevaluatedProperties": false,
            "required": [
                "reseller"
            ],
            "properties": {
                "reseller": {
                    "type": "object",
                    "description": "Reseller relationship",
                    "unevaluatedProperties": false,
                    "required": [
                        "ancestorCustomerId"
                    ],
                    "properties": {
                        "ancestorCustomerId": {
                            "$ref": "../components/baseTypes.schema.json#/$defs/uuidOrNull",
                            "description": "UUID of the ancestor reseller customer, null only for the root customer.",
                            "x-status": "approved"
                        }
                    },
                    "x-status": "approved"
                },
                "invoiceRecipient": {
                    "type": "object",
                    "description": "Invoicing relationship",
                    "unevaluatedProperties": false,
                    "required": [
                        "ancestorCustomerId"
                    ],
                    "properties": {
                        "ancestorCustomerId": {
                            "$ref": "../components/baseTypes.schema.json#/$defs/uuidOrNull",
                            "description": "UUID of the ancestor invoice recipient customer.",
                            "x-status": "approved"
                        }
                    }
                },
                "conditionOwner": {
                    "type": "object",
                    "description": "Condition relationship",
                    "unevaluatedProperties": false,
                    "required": [
                        "ancestorCustomerId"
                    ],
                    "properties": {
                        "ancestorCustomerId": {
                            "$ref": "../components/baseTypes.schema.json#/$defs/uuidOrNull",
                            "description": "UUID of the ancestor condition owner customer.",
                            "x-status": "approved"
                        }
                    },
                    "x-status": "approved"
                },
                "parent": {
                    "type": "object",
                    "description": "Hierarchy relationship",
                    "unevaluatedProperties": false,
                    "required": [
                        "ancestorCustomerId"
                    ],
                    "properties": {
                        "ancestorCustomerId": {
                            "$ref": "../components/baseTypes.schema.json#/$defs/uuidOrNull",
                            "description": "UUID of the ancestor hierarchy parent customer."
                        }
                    }
                }
            },
            "x-status": "approved"
        },
        "homepage": {
            "type": [
                "string",
                "null"
            ],
            "format": "uri",
            "maxLength": 80,
            "description": "The customer's homepage URL.",
            "x-status": "approved"
        },
        "currency": {
            "type": [
                "string",
                "null"
            ],
            "pattern": "^[A-Z]{3}$",
            "description": "The ISO 4217 currency code representing the customer's default currency.",
            "x-status": "approved"
        },
        "shippingInstruction": {
            "type": [
                "string",
                "null"
            ],
            "enum": [
                "Partial",
                "Complete",
                null
            ],
            "description": "Special instructions for shipping to the customer.",
            "x-status": "approved"
        },
        "isPremiumCustomer": {
            "type": "boolean",
            "default": false,
            "description": "Indicates whether the customer is classified as a premium customer.",
            "x-status": "approved"
        },
        "salesFunnelStage": {
            "type": "string",
            "enum": [
                "NewCustomer",
                "ExistingCustomer",
                "TargetCustomer"
            ],
            "description": "The sales funnel stage of the customer (from the ERP).",
            "x-status": "approved"
        },
        "defaultCustomerReference": {
            "$ref": "../components/baseTypes.schema.json#/$defs/singleLineTextOrNull",
            "maxLength": 35,
            "description": "Reference to use on invoices and other documents when the customer provies no specific reference.",
            "x-status": "approved"
        },
        "requestForErpCustomerBlock": {
            "type": "boolean",
            "description": "Indicates whether there is a request to block the customer in the ERP system.",
            "x-status": "approved"
        },
        "ourContactPersons": {
            "type": "object",
            "description": "Information about our contact persons at the customer's organization.",
            "properties": {
                "salespersonEployeeId": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/uuidOrNull",
                    "description": "UUID of the salesperson employee who is responsible for the customer."
                },
                "advisorId": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/uuidOrNull",
                    "description": "UUID of the advisor employee who is responsible for the customer."
                },
                "personInChargeId": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/uuidOrNull",
                    "description": "UUID of the person in charge employee who is responsible for the customer."
                }
            }
        },
        "shippingAgentCode": {
            "$ref": "../components/baseTypes.schema.json#/$defs/codeOrNull",
            "maxLength": 10,
            "description": "Code identifying the customer's shipping agent.",
            "x-status": "approved"
        },
        "classifications": {
            "type": "object",
            "properties": {
                "salesClass": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/codeOrNull",
                    "maxLength": 10
                },
                "potential": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/codeOrNull",
                    "maxLength": 10
                },
                "divisionCode": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/codeOrNull",
                    "maxLength": 10
                },
                "subdivisionCode": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/codeOrNull",
                    "maxLength": 20
                }
            }
        },
        "billingAndPayment": {
            "type": "object",
            "properties": {
                "customerPriceGroupId": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/uuidOrNull",
                    "description": "UUID referencing the customer price group that is assigned to the customer."
                },
                "isPriceGroupCustomer": {
                    "type": "boolean",
                    "default": false
                },
                "priceBookGroupId": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/uuidOrNull",
                    "description": "can only be set if the isPriceGroupCustomer is set to true"
                },
                "ignoreMaterialSurcharge": {
                    "type": "boolean",
                    "default": false
                },
                "excludeFromMinQuantitySurcharge": {
                    "type": "boolean",
                    "default": false
                },
                "salesOnlyWithSpecialPrice": {
                    "type": "boolean",
                    "default": false
                },
                "orderLimitActive": {
                    "type": "boolean",
                    "default": false
                },
                "combineShipments": {
                    "type": "boolean",
                    "default": false
                },
                "purchasingAssociation": {
                    "type": "boolean",
                    "default": false
                },
                "bundleReturn": {
                    "type": "boolean",
                    "default": false
                },
                "paymentTermsId": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/uuidOrNull",
                    "description": "UUID referencing the payment terms assigned to the customer."
                },
                "paymentMethodCode": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/codeOrNull",
                    "maxLength": 10
                },
                "creditStandingCode": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/codeOrNull",
                    "maxLength": 10
                },
                "creditStandingCheckStatus": {
                    "type": "string",
                    "enum": [
                        "NotChecked",
                        "CheckNecessary",
                        "CheckRequested",
                        "Checked"
                    ]
                },
                "creditStandingCheckDate": {
                    "type": "string",
                    "format": "date-time"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "creditStandingCheckStatus": {
                                "const": "Checked"
                            }
                        },
                        "required": [
                            "creditStandingCheckStatus"
                        ]
                    },
                    "then": {
                        "required": [
                            "creditStandingCheckDate"
                        ]
                    },
                    "else": {
                        "not": {
                            "required": [
                                "creditStandingCheckDate"
                            ]
                        }
                    }
                }
            ],
            "x-status": "approved"
        },
        "customerGroupMembership": {
            "type": "object",
            "properties": {
                "customerGroupId": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/uuidOrNull",
                    "x-status": "approved"
                },
                "membershipNumber": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/codeOrNull",
                    "x-status": "approved"
                },
                "glnMembershipNumber": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/codeOrNull",
                    "x-status": "approved"
                },
                "membershipSince": {
                    "type": "string",
                    "format": "date",
                    "x-status": "approved"
                },
                "membershipUntil": {
                    "type": "string",
                    "format": "date",
                    "x-status": "approved"
                },
                "bonusGroup": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/singleLineTextOrNull",
                    "maxLength": 20,
                    "x-status": "approved"
                },
                "purchaseGroup": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/singleLineTextOrNull",
                    "x-status": "approved"
                },
                "billersInvoiceRecipeintId": {
                    "$ref": "../components/baseTypes.schema.json#/$defs/singleLineTextOrNull",
                    "x-status": "approved"
                }
            }
        },
        "openingHours": {
            "$ref": "../components/openinghours.schema.json"
        },
        "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 date-time when the customer was first created in the owning system.",
            "x-status": "approved"
        },
        "createdById": {
            "$ref": "../components/baseTypes.schema.json#/$defs/uuid",
            "description": "UUID of the employee who created the customer.",
            "x-status": "approved"
        },
        "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 date-time when the customer was last updated in the owning system.",
            "x-status": "approved"
        },
        "updatedById": {
            "$ref": "../components/baseTypes.schema.json#/$defs/uuidOrNull",
            "description": "UUID of the employee who last updated the customer.",
            "x-status": "approved"
        },
        "contentHash": {
            "type": "string",
            "description": "Hash value calculated by the owning system based on the content of the customer record. The content hash is used to detect changes in the customer record and to determine whether updates are needed when synchronizing customer data across systems.",
            "x-status": "needsDiscussion"
        }
    },
    "allOf": [
        {
            "$ref": "../components/address.schema.json"
        },
        {
            "if": {
                "properties": {
                    "blockedFor": {
                        "enum": [
                            "shipping",
                            "invoicing",
                            "all"
                        ]
                    }
                },
                "required": [
                    "blockedFor"
                ]
            },
            "then": {
                "required": [
                    "blockedForReason"
                ]
            }
        }
    ],
    "dependentRequired": {
        "name2": [
            "name1"
        ],
        "blockedForReasonId": [
            "blockedFor"
        ]
    }
}