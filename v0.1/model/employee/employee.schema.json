{
    "$id": "customerPriceGroup.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-revision": "2026-05-26",
    "type": "object",
    "unevaluatedProperties": false,
    "required": [
        "id",
        "employeeNumber",
        "firstName",
        "lastName",
        "statusCode",
        "customerPriceGroup"
    ],
    "properties": {
        "id": {
            "$ref": "../components/basetypes.schema.json#/$defs/uuid",
            "description": "The unique identifier for the employee.",
            "x-status": "approved"
        },
        "employeeNumber": {
            "$ref": "../components/basetypes.schema.json#/$defs/code",
            "maxLength": 20,
            "description": "The unique employee number, this is also used to link the employee to an AD user.",
            "x-status": "approved"
        },
        "statusCode": {
            "type": "string",
            "enum": [
                "active",
                "inactive",
                "terminated",
                "future"
            ],
            "description": "The code representing the employee's status.",
            "x-status": "approved"
        },
        "salesPersonCode": {
            "$ref": "../components/basetypes.schema.json#/$defs/code",
            "maxLength": 10,
            "description": "The unique code for the responsibility center.",
            "x-status": "approved"
        },
        "firstName": {
            "$ref": "../components/basetypes.schema.json#/$defs/singleLineText",
            "maxLength": 30,
            "description": "The first name of the employee.",
            "x-status": "approved"
        },
        "lastName": {
            "$ref": "../components/basetypes.schema.json#/$defs/singleLineText",
            "maxLength": 30,
            "description": "The last name of the employee.",
            "x-status": "approved"
        },
        "jobCode": {
            "$ref": "../components/basetypes.schema.json#/$defs/code",
            "maxLength": 20,
            "description": "Identifies the role of the employee within the organization.",
            "x-status": "approved"
        },
        "jobDescription": {
            "$ref": "../components/basetypes.schema.json#/$defs/singleLineTextOrNull",
            "maxLength": 100,
            "description": "Identifies the role of the employee within the organization.",
            "x-status": "approved"
        },
        "phoneNumber": {
            "$ref": "../components/basetypes.schema.json#/$defs/phoneE164OrNull",
            "description": "Phone number of the employee.",
            "x-status": "approved"
        },
        "mobilePhoneNumber": {
            "$ref": "../components/basetypes.schema.json#/$defs/phoneE164OrNull",
            "description": "Mobile phone number of the employee.",
            "x-status": "approved"
        },
        "emailAddress": {
            "$ref": "../components/basetypes.schema.json#/$defs/emailOrNull",
            "description": "Email address of the employee.",
            "x-status": "approved"
         },      
         "customerPriceGroup": {
            "$ref": "../components/basetypes.schema.json#/$defs/code",
            "maxLength": 10,
            "description": "The code of the customer price group associated with the employee.",
            "x-status": "approved"
         }
    }
}