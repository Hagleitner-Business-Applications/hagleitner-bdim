{
  "$id": "openingHours.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-revision": "2026-08-18",
  "description": "Opening hours for a defined date range.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "startingDate",
    "endingDate",
    "opensAt",
    "closesAt",
    "monday",
    "tuesday",
    "wednesday",
    "thursday",
    "friday",
    "saturday",
    "sunday"
  ],
  "properties": {
    "seasonCode": {
      "$ref": "basetypes.schema.json#/$defs/singleLineTextOrNull"
    },
    "area": {
      "$ref": "basetypes.schema.json#/$defs/areaOrNull"
    },
    "startingDate": {
      "type": "string",
      "format": "date"
    },
    "endingDate": {
      "type": "string",
      "format": "date"
    },
    "opensAt": {
      "type": "string",
      "format": "time"
    },
    "closesAt": {
      "type": "string",
      "format": "time"
    },
    "monday": {
      "type": "boolean"
    },
    "tuesday": {
      "type": "boolean"
    },
    "wednesday": {
      "type": "boolean"
    },
    "thursday": {
      "type": "boolean"
    },
    "friday": {
      "type": "boolean"
    },
    "saturday": {
      "type": "boolean"
    },
    "sunday": {
      "type": "boolean"
    }
  }
}