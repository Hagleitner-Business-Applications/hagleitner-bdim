{
    "$id": "https://schema.hagleitner.com/bdim/v0.1/openinghours.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-revision": "2026-06-05",
    "description": "Generic schema for opening hours with multiple date intervals and multiple opening time slots per day.",
    "type": "object",
    "unevaluatedProperties": false,
    "required": [
        "intervals"
    ],
    "properties": {
        "intervals": {
            "type": "array",
            "description": "Date intervals with weekday-specific opening slots.",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/openingInterval"
            }
        },
        "closingDays": {
            "type": "array",
            "description": "Closed date-time ranges, optionally scoped by season and area.",
            "default": [],
            "items": {
                "$ref": "#/$defs/closingRange"
            }
        }
    },
    "$defs": {
        "seasonCode": {
            "type": [
                "string",
                "null"
            ],
            "enum": [
                "Winter",
                "Summer",
                null
            ]
        },
        "area": {
            "type": [
                "string",
                "null"
            ],
            "enum": [
                "Shipment",
                "Service",
                "Maintenance",
                "Salesperson",
                "All",
                null
            ]
        },
        "timeValue": {
            "type": "string",
            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
            "description": "24-hour time in HH:mm format."
        },
        "timeSlot": {
            "type": "object",
            "description": "One opening slot that applies to one or more weekdays.",
            "unevaluatedProperties": false,
            "required": [
                "opensAt",
                "closesAt",
                "weekdays"
            ],
            "properties": {
                "opensAt": {
                    "$ref": "#/$defs/timeValue"
                },
                "closesAt": {
                    "$ref": "#/$defs/timeValue"
                },
                "weekdays": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "enum": [
                            "monday",
                            "tuesday",
                            "wednesday",
                            "thursday",
                            "friday",
                            "saturday",
                            "sunday"
                        ]
                    }
                }
            }
        },
        "weekSchedule": {
            "type": "array",
            "description": "Opening slots where each slot declares the weekdays it applies to.",
            "items": {
                "$ref": "#/$defs/timeSlot"
            },
            "default": []
        },
        "openingInterval": {
            "type": "object",
            "description": "Opening-hours definition valid for one date interval.",
            "unevaluatedProperties": false,
            "required": [
                "startingDate",
                "endingDate",
                "days"
            ],
            "properties": {
                "seasonCode": {
                    "$ref": "#/$defs/seasonCode"
                },
                "area": {
                    "$ref": "#/$defs/area"
                },
                "startingDate": {
                    "type": "string",
                    "format": "date"
                },
                "endingDate": {
                    "type": "string",
                    "format": "date"
                },
                "days": {
                    "$ref": "#/$defs/weekSchedule"
                }
            }
        },
        "closingRange": {
            "type": "object",
            "description": "A closed date-time range, optionally scoped by season and area.",
            "unevaluatedProperties": false,
            "required": [
                "startAt",
                "endAt"
            ],
            "properties": {
                "startAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "endAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "seasonCode": {
                    "$ref": "#/$defs/seasonCode"
                },
                "area": {
                    "$ref": "#/$defs/area"
                },
                "reason": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 120
                }
            }
        }
    }
}